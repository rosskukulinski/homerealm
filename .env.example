# homerealm configuration — copy to .env and edit.

# --- Tailscale (the panel and every world join your tailnet) ---
# RECOMMENDED: an API OAuth client, so homerealm mints its own world keys.
# Create one at https://login.tailscale.com/admin/settings/oauth with ONLY
# the "auth_keys" scope, restricted to the tag below (your tailnet policy
# must define that tag under tagOwners first). Worlds then join as tagged
# devices — owned by the tag, not a person, key expiry auto-disabled — and
# you never create or rotate an auth key again.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=

# Tag stamped on every world node the panel creates.
TS_TAG=tag:homerealm

# FALLBACK: a static reusable auth key (Reusable + Pre-approved, from
# https://login.tailscale.com/admin/settings/keys). Only used when the
# OAuth client above is not configured. Also used by the panel itself on
# its very first start (or leave empty and open the login URL it prints
# to `docker logs homerealm` once). Note these keys expire within 90 days;
# existing nodes keep their identity, but new worlds will fail to join
# until you rotate it — the OAuth client avoids all of this.
TS_AUTHKEY=

# The panel's tailnet hostname (worlds are always mc-<name>)
TS_HOSTNAME=homerealm

# Panel admins: comma-separated tailnet logins (as shown in the panel footer,
# e.g. you@example.com or you@github). Admins can do anything; other tailnet
# users can create worlds and manage/delete their OWN worlds, and read the
# rest; everyone else (LAN, tagged nodes) is read-only.
# LEAVE EMPTY to make every tailnet user an admin (the pre-0.2 behavior).
PANEL_ADMINS=

# Host path where worlds live (created by setup.sh)
HOST_DATA_DIR=/volume1/docker/homerealm

# Owner for world files. On Synology run `id <your-user>` — use uid=/gid= values.
PUID=1000
PGID=100

# Plain-HTTP panel on the LAN (handy for non-Tailscale devices at home).
# LAN visitors have no Tailscale identity, so they get a read-only view.
# Set false for tailnet-only access.
PANEL_LISTEN_LAN=true
PANEL_PORT=8090

# First world's LAN UDP port; each new world takes the next one up.
# (On the tailnet every world answers on the default port 19132.)
BASE_PORT=19132

# On-demand backups (per world, from its detail page) keep this many of the
# most recent .tar.gz files under _backups/<world>/ — older ones are pruned.
BACKUP_KEEP=10

# --- Optional: LAN auto-discovery (worlds appear under "LAN Games") ---
# For consoles/tablets that can't run Tailscale. Requires a docker macvlan
# network and a handful of static IPs on your LAN that are OUTSIDE your DHCP
# pool. See README before enabling.
DISCOVERY_ENABLED=false
MACVLAN_NETWORK=mcnet
WORLD_IP_PREFIX=192.168.1.
WORLD_IP_FIRST=250
WORLD_IP_LAST=254
