{{define "content"}}
<header>
 <h1>&#9968; homerealm</h1>
 <div class="headright">
  {{if .Identity}}<span class="chip" title="your Tailscale identity">&#128100; {{.Identity}} &middot; {{.Role}}</span>{{end}}
  {{if .CanCreate}}<button type="button" class="btn primary" id="newbtn">&#65291; New world</button>{{end}}
 </div>
</header>
{{if .IsReader}}<div class="notice">&#128274; <b>Read-only view.</b> You&#8217;re not signed in via
Tailscale &mdash; open the panel from a Tailscale device to create or manage worlds.</div>{{end}}
{{if not .HasWorlds}}<div class="empty"><div class="bigmoji">&#9968;</div>
<p><b>No worlds yet.</b><br>Tap <b>&#65291; New world</b> to create the first one &mdash; it&#8217;ll be on your tailnet in about 30 seconds.</p></div>{{end}}
{{if .ShowFilter}}<input type="search" id="worldfilter" placeholder="Filter worlds&#8230;" aria-label="filter worlds by name" autocomplete="off">{{end}}
{{range .Sections}}{{if .Title}}<h2>{{.Title}}</h2>{{end}}
{{range .Worlds}}<div class="world" data-world="{{.Name}}">
 <div class="strip" style="background:{{.Strip}}"></div>
 <div class="cardbody">
  <div class="cardhead">
   <a class="wlink" href="/world/{{.Name}}"><span class="wname">{{.Name}}</span></a>
   <span class="badge st-{{.Status}}" data-status="{{.Name}}"><i></i>{{.Status}}</span>
   {{if not .CanManage}}<span class="chip" title="only its owner or an admin can manage this world">&#128274; {{if and .Identified .Owner}}{{.Owner}}{{else if .Owner}}view only{{else}}admins only{{end}}</span>{{end}}
  </div>
  <div class="chips">
   <span class="chip">{{.ModeIcon}} {{.Mode}}</span>
   <span class="chip">{{.DiffIcon}} {{.Difficulty}}</span>
   {{if and .Owner .CanManage}}<span class="chip">&#128100; {{.Owner}}</span>{{end}}
   <span class="chip" data-mcver="{{.Name}}" title="Minecraft Bedrock version &#8212; player devices need the matching app version to join"{{if not .MCVersion}} hidden{{end}}>&#9935; {{.MCVersion}}{{if .UpdateTo}} &#8594; {{.UpdateTo}}{{end}}</span>
   <span class="chip warn" data-warn="{{.Name}}"{{if not .Warn}} hidden{{end}}>&#9888; {{.Warn}}</span>
   <span class="chip resource" data-resource="{{.Name}}"{{if or (ne .Status "running") (not .CPU)}} hidden{{end}}>&#129504; {{.CPU}} &middot; {{.Mem}}</span>
  </div>
  <div class="addr-row">
   {{if .TailscaleIP}}<button type="button" class="addr" data-copy="{{.TailscaleIP}}" title="Copy the Tailscale IP &#8212; more reliable than the hostname in the Minecraft app">{{.TailscaleIP}} &#10697;</button>
   <span>port <b>19132</b> via Tailscale</span>{{end}}
   {{if .HomeAuto}}<span class="chip">&#127968; LAN Games at home</span>{{else}}<span>&middot; LAN &lt;host&gt;:{{.Port}}</span>{{end}}
  </div>
  <div class="actions">
   {{if .CanManage}}
   {{if or (eq .Status "running") (eq .Status "starting")}}
   <form method="post" action="/stop/{{.Name}}"><button class="btn primary" data-busy="Stopping&#8230;">&#9724; Stop</button></form>
   {{else}}
   <form method="post" action="/start/{{.Name}}"><button class="btn primary" data-busy="Starting&#8230;">&#9654; Start</button></form>
   {{end}}
   {{end}}
   <a class="btn" href="/world/{{.Name}}">{{if .CanManage}}Manage{{else}}View{{end}} &#8594;</a>
  </div>
 </div>
</div>
{{end}}{{end}}
{{if .CanCreate}}<dialog id="newdlg" class="newdlg">
<div class="newbox"><b>New world</b>
 <form method="post" action="/new">
  <div class="newrow">
   <input name="name" placeholder="world-name" pattern="[a-z0-9-]{1,20}" required aria-label="world name">
  </div>
  <div class="presets">
  {{range .Presets}}<label class="preset"><input type="radio" name="preset" value="{{.Key}}"{{if eq .Key "survival-easy"}} checked{{end}}><span><span class="em">{{.Icon}}</span>{{.Label}}</span></label>{{end}}
  </div>
  <div class="newrow">
   <input name="seed" id="seedbox" placeholder="seed (optional)" size="14">
   <button type="button" class="btn" id="dice" title="random seed" aria-label="random seed">&#127922;</button>
   <label class="chip" style="min-height:42px"><input type="checkbox" name="flat" style="min-height:auto"> flat world</label>
  </div>
  <div class="newrow">
   <label class="chip" title="one player sleeping skips the night for everyone"><input type="checkbox" name="one_sleep" style="min-height:auto"> &#128564; one sleeps &#8594; day</label>
   <label class="chip" title="no dropped items on death"><input type="checkbox" name="keep_inventory" style="min-height:auto"> &#127890; keep inventory</label>
   <label class="chip" title="creepers and other mobs can't break builds"><input type="checkbox" name="no_mob_grief" style="min-height:auto"> &#128163; no creeper damage</label>
   <label class="chip" title="show coordinates on screen"><input type="checkbox" name="show_coordinates" style="min-height:auto"> &#128205; show coordinates</label>
  </div>
  <div class="newrow">
   <button class="btn primary" data-busy="Creating&#8230;">Create world</button>
   <button type="button" class="btn" id="newcancel">Cancel</button>
  </div>
 </form>
 <div class="meta" style="margin-top:.5rem">lowercase letters, numbers, dashes &middot; ready in ~30s &middot;
 joins your tailnet as <code>mc-&lt;name&gt;</code></div>
</div>
</dialog>{{end}}
<p class="meta">{{.DiscoveryNote}}</p>
{{end}}
{{define "scripts"}}
<script>
(function () {
  var btn = document.getElementById('newbtn');
  var dlg = document.getElementById('newdlg');
  if (btn && dlg) {
    btn.addEventListener('click', function () {
      dlg.showModal();
      var i = dlg.querySelector('input[name=name]');
      if (i) i.focus();
    });
    document.getElementById('newcancel').addEventListener('click', function () { dlg.close(); });
  }
  var f = document.getElementById('worldfilter');
  if (f) f.addEventListener('input', function () {
    var q = f.value.trim().toLowerCase();
    document.querySelectorAll('.world[data-world]').forEach(function (c) {
      c.hidden = q !== '' && c.dataset.world.indexOf(q) === -1;
    });
  });
})();
</script>
{{end}}
